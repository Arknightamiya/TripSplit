{
  "name": "tripsplit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TripSplit class project scaffold",
  "scripts": {
    "start": "bash start.sh",
    "dev": "node server/index.js",
    "db:check": "node scripts/db/check.js",
    "db:schema": "node scripts/db/apply-schema.js",
    "db:currency:refresh": "node scripts/db/refresh-currency-rates.js",
    "db:currency:convert": "node scripts/db/convert-currency.js",
    "test": "NODE_ENV=test node --test",
    "test:db": "NODE_ENV=test TRIPSPLIT_DATABASE_SMOKE=1 node -r dotenv/config --test tests/database-smoke.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "nodemailer": "^8.0.10",
    "pg": "^8.20.0"
  }
}
